{
  "name": "kontrack-monorepo",
  "version": "0.0.1",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "dev:web": "turbo dev --filter web",
    "dev:mobile": "turbo dev --filter mobile",
    "dev:admin": "turbo dev --filter admin",
    "dev:backend": "turbo dev --filter @workspace/backend",
    "dev:wab": "turbo dev --filter web --filter admin --filter @workspace/backend",
    "dev:wmb": "turbo dev --filter web --filter mobile --filter @workspace/backend",
    "dev:wmab": "turbo dev --filter web --filter mobile --filter admin --filter @workspace/backend",
    "lint": "turbo lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\""
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.6.2",
    "turbo": "^2.5.5",
    "typescript": "5.7.3"
  },
  "packageManager": "pnpm@10.4.1",
  "engines": {
    "node": ">=20"
  }
}
